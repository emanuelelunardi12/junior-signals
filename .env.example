# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
TELEGRAM_BOT_USERNAME=YourSignalsBot
# Random string; Telegram sends it back in a header so we know webhook calls are genuine
TELEGRAM_WEBHOOK_SECRET=change-me-long-random-string
# Telegram user IDs allowed to use /admin (comma separated)
ADMIN_IDS=

# --- Web app ---
BASE_URL=https://your-tunnel-or-domain.example
SESSION_SECRET=change-me-another-long-random-string
# 1 = show a "log in as test user" form (local development only, never in production)
DEV_LOGIN=1

# --- AI ---
ANTHROPIC_API_KEY=
MODEL_CLASSIFY=claude-haiku-4-5-20251001
MODEL_EXTRACT=claude-sonnet-5
MODEL_GRADE=claude-sonnet-5
# Prices in USD per million tokens, used only for cost reports. Fill from Anthropic's pricing page.
# Format: model=input/output,model=input/output
MODEL_PRICES=

# --- Data sources ---
# SEC requires a descriptive User-Agent with a contact email
SEC_USER_AGENT=JuniorSignals student project your.email@esade.edu
DATABASE_PATH=data/signals.db
# Price data for the "already moved" scoring rule: none | stooq (needs price_symbol in universe.yaml)
PRICE_SOURCE=none

# --- Scheduler (only enable on a single-worker deployment; otherwise use the host's cron) ---
RUN_SCHEDULER=0
PIPELINE_INTERVAL_HOURS=4
DIGEST_DAY=0
DIGEST_HOUR=8
